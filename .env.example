
# ============================================
# VETERINARIA SAN MARCOS - EV3
# Plantilla de configuración local
# ============================================

# Base de datos - Usuarios
USUARIOS_DB_URL=jdbc:mysql://localhost:3306/veterinaria_usuarios
USUARIOS_DB_USER=vet_usuarios
USUARIOS_DB_PASSWORD=REEMPLAZAR

# Base de datos - Mascotas
MASCOTAS_DB_URL=jdbc:mysql://localhost:3306/veterinaria_mascotas
MASCOTAS_DB_USER=vet_mascotas
MASCOTAS_DB_PASSWORD=REEMPLAZAR

# Base de datos - Citas
CITAS_DB_URL=jdbc:mysql://localhost:3306/veterinaria_citas
CITAS_DB_USER=vet_citas
CITAS_DB_PASSWORD=REEMPLAZAR

# Base de datos - Historial Clínico
HISTORIAL_DB_URL=jdbc:mysql://localhost:3306/veterinaria_historial
HISTORIAL_DB_USER=vet_historial
HISTORIAL_DB_PASSWORD=REEMPLAZAR

# Seguridad JWT
# Misma clave para todos los microservicios
JWT_SECRET=REEMPLAZAR_CON_CLAVE_BASE64
